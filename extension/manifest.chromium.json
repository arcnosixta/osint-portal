{
  "manifest_version": 3,
  "name": "OSINT Portal Connector",
  "version": "1.1.0",
  "description": "Коннектор OSINT Portal: соединяет сайт с локальными OSINT-утилитами на вашем компьютере. Без него утилиты не запускаются.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:8788/*", "http://127.0.0.1:8787/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://osint-portal-gamma.vercel.app/*", "http://localhost:3000/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
