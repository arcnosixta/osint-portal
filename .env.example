# --- OSINT Portal environment ---
# Copy to .env.local for local overrides.

# Comma-separated allow-list of targets that segments may run against
# (owned / authorized resources only). Used once tool execution ships.
# OSINT_ALLOWED_TARGETS=10.0.0.0/8,example.com,127.0.0.1

# Default timeout (ms) applied per tool run.
# OSINT_RUN_TIMEOUT_MS=15000