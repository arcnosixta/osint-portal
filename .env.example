# --- OSINT Portal environment ---
# Copy to .env.local for local overrides.

# Comma-separated allow-list of targets segments may run against
# (owned / authorized resources only). CIDRs, IPs, IPv6 and domains accepted.
# Defaults (without this variable): loopback, private (10/8, 172.16/12,
# 192.168/16), link-local, plus the `localhost` hostname.
# OSINT_ALLOWED_TARGETS=10.0.0.0/8,example.com,127.0.0.1

# Hard timeout (ms) applied per tool run.
# OSINT_RUN_TIMEOUT_MS=20000

# Max captured stdout/stderr bytes per run.
# OSINT_MAX_OUTPUT_BYTES=64000